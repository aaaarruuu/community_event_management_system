DELIMITER //

-- Procedure to create recurring events
CREATE PROCEDURE IF NOT EXISTS create_recurring_events(
    IN base_event_id INT,
    IN recurrence_count INT
)
BEGIN
    DECLARE i INT DEFAULT 0;
    DECLARE next_date DATE;
    DECLARE base_date DATE;
    DECLARE interval_days INT;
    DECLARE rec_type VARCHAR(20);

    -- Get base event details
    SELECT event_date, recurrence_interval, recurrence_type
    INTO base_date, interval_days, rec_type
    FROM events WHERE event_id = base_event_id;

    WHILE i < recurrence_count DO
        SET i = i + 1;

        -- Calculate next date based on recurrence type
        IF rec_type = 'WEEKLY' THEN
            SET next_date = DATE_ADD(base_date, INTERVAL (i * interval_days) WEEK);
        ELSEIF rec_type = 'MONTHLY' THEN
            SET next_date = DATE_ADD(base_date, INTERVAL (i * interval_days) MONTH);
        ELSE
            SET next_date = DATE_ADD(base_date, INTERVAL (i * interval_days) DAY);
        END IF;

        -- Create new event instance
        INSERT INTO events (event_name, description, event_date, venue, capacity,
                           organizer_id, category, status, parent_event_id, created_by, created_date)
        SELECT event_name, description, next_date, venue, capacity,
               organizer_id, category, 'UPCOMING', base_event_id, created_by, NOW()
        FROM events WHERE event_id = base_event_id;
    END WHILE;
END //

DELIMITER ;

-- ============================================================================
-- TRIGGERS (for automatic updates)
-- ============================================================================

-- Update event average rating when feedback is added
DELIMITER //

CREATE TRIGGER IF NOT EXISTS update_event_rating
AFTER INSERT ON event_feedback
FOR EACH ROW
BEGIN
    UPDATE events e
    SET e.average_rating = (
        SELECT AVG(rating)
        FROM event_feedback
        WHERE event_id = NEW.event_id
    )
    WHERE e.event_id = NEW.event_id;
END //

-- Update poll total votes
CREATE TRIGGER IF NOT EXISTS update_poll_votes
AFTER INSERT ON poll_votes
FOR EACH ROW
BEGIN
    UPDATE polls
    SET total_votes = total_votes + 1
    WHERE poll_id = NEW.poll_id;
END //

-- Log activity when user registers for event
CREATE TRIGGER IF NOT EXISTS log_event_registration
AFTER INSERT ON registrations
FOR EACH ROW
BEGIN
    INSERT INTO activity_logs (user_id, action_type, action_description, entity_type, entity_id)
    VALUES (NEW.user_id, 'REGISTER_EVENT',
            CONCAT('Registered for event ID: ', NEW.event_id),
            'EVENT', NEW.event_id);
END //

DELIMITER ;

