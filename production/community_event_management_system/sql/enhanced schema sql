-- ============================================================================
-- USEFUL VIEWS
-- ============================================================================

-- View for event statistics
CREATE OR REPLACE VIEW event_statistics AS
SELECT
    e.event_id,
    e.event_name,
    e.event_date,
    e.category,
    e.capacity,
    COUNT(DISTINCT r.user_id) as registered_count,
    COALESCE(AVG(ef.rating), 0) as average_rating,
    COUNT(DISTINCT ef.feedback_id) as feedback_count,
    (COUNT(DISTINCT r.user_id) * 100.0 / e.capacity) as fill_rate
FROM events e
LEFT JOIN registrations r ON e.event_id = r.event_id
LEFT JOIN event_feedback ef ON e.event_id = ef.event_id
GROUP BY e.event_id;

-- View for booking conflicts
CREATE OR REPLACE VIEW booking_availability AS
SELECT
    a.amenity_id,
    a.name,
    ab.booking_date,
    ab.start_time,
    ab.end_time,
    ab.status
FROM amenities a
LEFT JOIN amenity_bookings ab ON a.amenity_id = ab.amenity_id
WHERE ab.status IN ('CONFIRMED', 'PENDING')
ORDER BY a.amenity_id, ab.booking_date, ab.start_time;

