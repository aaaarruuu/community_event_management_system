-- ENHANCED EVENTS TABLE
-- ============================================================================

-- Add new columns to existing events table
ALTER TABLE events
ADD COLUMN IF NOT EXISTS registration_start DATE,
ADD COLUMN IF NOT EXISTS registration_end DATE,
ADD COLUMN IF NOT EXISTS allow_waitlist BOOLEAN DEFAULT TRUE,
ADD COLUMN IF NOT EXISTS is_recurring BOOLEAN DEFAULT FALSE,
ADD COLUMN IF NOT EXISTS recurrence_type VARCHAR(20), -- DAILY, WEEKLY, MONTHLY
ADD COLUMN IF NOT EXISTS recurrence_interval INT DEFAULT 1,
ADD COLUMN IF NOT EXISTS recurrence_end_date DATE,
ADD COLUMN IF NOT EXISTS parent_event_id INT,
ADD COLUMN IF NOT EXISTS FOREIGN KEY (parent_event_id) REFERENCES events(event_id);

-- ============================================================================
-- EVENT FEEDBACK TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS event_feedback (
    feedback_id INT PRIMARY KEY AUTO_INCREMENT,
    event_id INT NOT NULL,
    user_id INT NOT NULL,
    rating INT NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment TEXT,
    submitted_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    is_anonymous BOOLEAN DEFAULT FALSE,
    verified BOOLEAN DEFAULT FALSE, -- Whether user actually attended
    helpful_count INT DEFAULT 0,
    aspect_ratings JSON, -- {"venue": 5, "organization": 4, "content": 5}

    FOREIGN KEY (event_id) REFERENCES events(event_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,

    -- Prevent duplicate feedback from same user
    UNIQUE KEY unique_feedback (event_id, user_id)
);

CREATE INDEX idx_event_feedback_event ON event_feedback(event_id);
CREATE INDEX idx_event_feedback_rating ON event_feedback(rating);

-- ============================================================================
-- AMENITIES TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS amenities (
    amenity_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    category VARCHAR(50) NOT NULL, -- GYM, POOL, CLUBHOUSE, COURT, HALL, GARDEN
    capacity INT DEFAULT 1,
    cost_per_hour DECIMAL(10,2) DEFAULT 0.00,
    operating_hours VARCHAR(50), -- e.g., "06:00-22:00"
    requires_approval BOOLEAN DEFAULT FALSE,
    minimum_booking_hours INT DEFAULT 1,
    maximum_booking_hours INT DEFAULT 4,
    amenity_rules TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    location VARCHAR(200),
    photos JSON, -- Array of photo URLs
    rating DECIMAL(3,2) DEFAULT 0.00,
    booking_count INT DEFAULT 0,
    created_date DATETIME DEFAULT CURRENT_TIMESTAMP,

    INDEX idx_amenity_category (category),
    INDEX idx_amenity_active (is_active)
);

-- ============================================================================
-- AMENITY BOOKINGS TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS amenity_bookings (
    booking_id INT PRIMARY KEY AUTO_INCREMENT,
    amenity_id INT NOT NULL,
    user_id INT NOT NULL,
    booking_date DATE NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    duration_hours INT NOT NULL,
    total_cost DECIMAL(10,2) DEFAULT 0.00,
    status VARCHAR(20) DEFAULT 'PENDING', -- PENDING, CONFIRMED, CANCELLED, COMPLETED
    purpose VARCHAR(200),
    attendees INT DEFAULT 1,
    special_requests TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    confirmed_at DATETIME,
    cancelled_at DATETIME,
    cancellation_reason TEXT,

    -- Payment fields
    is_paid BOOLEAN DEFAULT FALSE,
    payment_method VARCHAR(50),
    payment_transaction_id VARCHAR(100),
    payment_date DATETIME,

    FOREIGN KEY (amenity_id) REFERENCES amenities(amenity_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,

    INDEX idx_booking_amenity (amenity_id),
    INDEX idx_booking_user (user_id),
    INDEX idx_booking_date (booking_date),
    INDEX idx_booking_status (status),

    -- Prevent double booking (same amenity, date, overlapping time)
    CONSTRAINT check_no_overlap
    UNIQUE KEY unique_booking_slot (amenity_id, booking_date, start_time, end_time)
);

-- ============================================================================
-- POLLS TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS polls (
    poll_id INT PRIMARY KEY AUTO_INCREMENT,
    question VARCHAR(500) NOT NULL,
    description TEXT,
    options JSON NOT NULL, -- Array of options: ["Option 1", "Option 2", ...]
    created_by INT NOT NULL,
    start_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    end_date DATETIME,
    is_anonymous BOOLEAN DEFAULT TRUE,
    allow_multiple_choice BOOLEAN DEFAULT FALSE,
    category VARCHAR(50), -- GENERAL, EVENT, AMENITY, RULE_CHANGE, BUDGET
    status VARCHAR(20) DEFAULT 'DRAFT', -- DRAFT, ACTIVE, CLOSED, CANCELLED
    total_votes INT DEFAULT 0,
    results JSON, -- {"Option 1": 10, "Option 2": 25, ...}
    results_visible BOOLEAN DEFAULT FALSE,
    created_date DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (created_by) REFERENCES users(user_id),

    INDEX idx_poll_status (status),
    INDEX idx_poll_category (category),
    INDEX idx_poll_end_date (end_date)
);

-- ============================================================================
-- POLL VOTES TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS poll_votes (
    vote_id INT PRIMARY KEY AUTO_INCREMENT,
    poll_id INT NOT NULL,
    user_id INT, -- NULL if anonymous
    selected_option VARCHAR(500) NOT NULL,
    voted_at DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (poll_id) REFERENCES polls(poll_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL,

    INDEX idx_vote_poll (poll_id),
    INDEX idx_vote_user (user_id),

    -- Prevent double voting (for non-anonymous polls)
    UNIQUE KEY unique_vote (poll_id, user_id)
);

-- ============================================================================
-- ANNOUNCEMENTS TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS announcements (
    announcement_id INT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(200) NOT NULL,
    message TEXT NOT NULL,
    category VARCHAR(50), -- GENERAL, URGENT, MAINTENANCE, EVENT, RULE, SAFETY
    priority VARCHAR(20) DEFAULT 'MEDIUM', -- LOW, MEDIUM, HIGH, CRITICAL
    posted_by INT NOT NULL,
    posted_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    expiry_date DATETIME,
    is_pinned BOOLEAN DEFAULT FALSE,
    requires_acknowledgment BOOLEAN DEFAULT FALSE,
    view_count INT DEFAULT 0,
    acknowledgment_count INT DEFAULT 0,
    attachments JSON, -- Array of attachment URLs
    target_audience VARCHAR(50) DEFAULT 'ALL', -- ALL, OWNERS, TENANTS, COMMITTEE

    FOREIGN KEY (posted_by) REFERENCES users(user_id),

    INDEX idx_announcement_priority (priority),
    INDEX idx_announcement_category (category),
    INDEX idx_announcement_posted_date (posted_date),
    INDEX idx_announcement_pinned (is_pinned)
);

-- ============================================================================
-- ANNOUNCEMENT ACKNOWLEDGMENTS TABLE
-- ============================================================================

CREATE TABLE IF NOT EXISTS announcement_acknowledgments (
    acknowledgment_id INT PRIMARY KEY AUTO_INCREMENT,
    announcement_id INT NOT NULL,
    user_id INT NOT NULL,
    acknowledged_at DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (announcement_id) REFERENCES announcements(announcement_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,

    UNIQUE KEY unique_acknowledgment (announcement_id, user_id)
);

-- ============================================================================
-- ACTIVITY LOG TABLE (for tracking user actions)
-- ============================================================================

CREATE TABLE IF NOT EXISTS activity_logs (
    log_id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT,
    action_type VARCHAR(50) NOT NULL, -- LOGIN, CREATE_EVENT, REGISTER, REPORT_ISSUE, etc.
    action_description VARCHAR(500),
    entity_type VARCHAR(50), -- EVENT, ISSUE, BOOKING, etc.
    entity_id INT,
    ip_address VARCHAR(45),
    user_agent TEXT,
